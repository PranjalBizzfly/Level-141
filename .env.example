# Public site URL, used for canonical URLs, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Form delivery for the contact form and the Growth Architecture waitlist.
# Configure Resend email, a webhook, or both. With neither, forms report
# "not configured" to visitors instead of pretending the submission was saved.

# Email through Resend (resend.com). All three values are required.
RESEND_API_KEY=
FORM_FROM_EMAIL=
FORM_TO_EMAIL=

# Webhook: each submission is POSTed as JSON (CRM, Zapier, Make, etc.).
FORM_WEBHOOK_URL=
# Optional shared secret, sent as the X-Level141-Secret header.
FORM_WEBHOOK_SECRET=
